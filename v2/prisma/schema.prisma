// FILE: prisma/schema.prisma
// PURPOSE: MarketplaceDB schema for TunerSwap multi-vendor platform
// STATUS: Production-ready (SQLite for dev, switch to PostgreSQL for prod)
//
// This schema defines the custom marketplace database that sits alongside Vendure.
// Vendure handles core commerce (products, orders, payments).
// MarketplaceDB handles vendor-specific data with true row-level isolation.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/marketplace-client"
}

datasource db {
  provider = "sqlite"
  url      = env("MARKETPLACE_DATABASE_URL")
}

// =============================================================================
// SELLER / VENDOR
// =============================================================================
model Seller {
  id                  Int       @id @default(autoincrement())

  // Public identifiers
  slug                String    @unique

  // Personal Information
  firstName           String
  lastName            String
  email               String    @unique
  phone               String?
  location            String?
  address             String?

  // Business Information
  businessName        String?
  website             String?
  bio                 String?
  description         String?

  // Social Links (JSON string: [{type, url}])
  socialLinks         String?   @default("[]")

  // Profile Assets
  profileImageUrl     String?
  bannerImageUrl      String?

  // Tuning Expertise
  experience          String?
  software            String?   @default("[]") // JSON array as string
  vehiclePlatforms    String?   @default("[]") // JSON array as string
  tuneTypes           String?   @default("[]") // JSON array as string
  hasDyno             Boolean   @default(false)

  // Business Hours (JSON string)
  businessHours       String?   @default("{}")

  // Status & Verification
  status              String    @default("PENDING") // PENDING, APPROVED, SUSPENDED, REJECTED
  verified            Boolean   @default(false)
  verifiedAt          DateTime?
  rejectionReason     String?
  suspensionReason    String?

  // Cached Statistics
  rating              Float     @default(0)
  reviewCount         Int       @default(0)
  tunesSold           Int       @default(0)
  partsSold           Int       @default(0)
  servicesDone        Int       @default(0)
  totalOrders         Int       @default(0)
  totalRevenue        Float     @default(0)

  // Payment Integration - Stripe Connect
  stripeConnected           Boolean   @default(false)
  stripeAccountId           String?
  stripeAccountStatus       String?   // pending, enabled, restricted, disabled
  stripePayoutsEnabled      Boolean   @default(false)
  stripeChargesEnabled      Boolean   @default(false)
  stripeDetailsSubmitted    Boolean   @default(false)
  stripeOnboardingComplete  Boolean   @default(false)
  stripeAccountCreatedAt    DateTime?

  // Payment Integration - PayPal
  paypalConnected     Boolean   @default(false)
  paypalEmail         String?

  // Vendure Integration IDs
  vendureSellerId     String?   @unique
  vendureChannelId    String?
  vendureAdminId      String?
  vendureCustomerId   String?

  // Auth
  passwordHash        String
  lastLoginAt         DateTime?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  products            Product[]
  orders              Order[]
  invoices            Invoice[]
  reviews             Review[]
  messages            Message[] @relation("SellerMessages")
  calendarEvents      CalendarEvent[]
  syncLogs            SyncLog[]
  payouts             Payout[]

  @@index([status])
  @@index([vendureSellerId])
  @@index([createdAt])
  @@map("sellers")
}

// =============================================================================
// PRODUCT
// =============================================================================
model Product {
  id                  Int       @id @default(autoincrement())

  // Identifiers
  sku                 String
  slug                String

  // Basic Info
  name                String
  description         String?

  // Pricing
  price               Float
  compareAtPrice      Float?

  // Vendor
  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Product Type
  productType         String    // TUNE, PART, SERVICE
  isDigital           Boolean   @default(false)

  // Inventory
  stockLevel          Int       @default(0)
  trackInventory      Boolean   @default(true)

  // Status
  status              String    @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED, DELETED
  publishedAt         DateTime?

  // Assets
  featuredImageUrl    String?
  imageUrls           String?   @default("[]") // JSON array

  // SEO
  metaTitle           String?
  metaDescription     String?

  // Vendure Integration
  vendureProductId    String?   @unique
  vendureVariantId    String?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  tuneFiles           TuneFile[]
  productCollections  ProductCollection[]
  orderLines          OrderLine[]
  reviews             Review[]
  facetValues         ProductFacetValue[]
  compatibility       ProductCompatibility[]

  @@unique([vendorId, sku])
  @@index([vendorId])
  @@index([productType])
  @@index([status])
  @@index([vendureProductId])
  @@map("products")
}

// =============================================================================
// TUNE FILE (Digital Product Files)
// =============================================================================
model TuneFile {
  id                  Int       @id @default(autoincrement())

  productId           Int
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  fileName            String
  filePath            String
  fileSize            Int
  fileHash            String
  mimeType            String

  ecuType             String?
  platform            String?

  // Compatibility (JSON string)
  compatibility       String    @default("[]")

  downloadCount       Int       @default(0)

  uploadedAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([productId])
  @@index([fileHash])
  @@map("tune_files")
}

// =============================================================================
// PRODUCT COMPATIBILITY
// =============================================================================
model ProductCompatibility {
  id                  Int       @id @default(autoincrement())

  productId           Int
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  make                String
  model               String
  yearStart           Int?
  yearEnd             Int?
  engine              String?
  transmission        String?
  notes               String?

  @@unique([productId, make, model, yearStart, yearEnd, engine])
  @@index([make, model])
  @@map("product_compatibility")
}

// =============================================================================
// COLLECTION
// =============================================================================
model Collection {
  id                  Int       @id @default(autoincrement())

  name                String
  slug                String    @unique
  description         String?

  parentId            Int?
  parent              Collection? @relation("CollectionHierarchy", fields: [parentId], references: [id])
  children            Collection[] @relation("CollectionHierarchy")

  position            Int       @default(0)
  imageUrl            String?

  vendureCollectionId String?   @unique

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  products            ProductCollection[]

  @@map("collections")
}

model ProductCollection {
  id                  Int       @id @default(autoincrement())

  productId           Int
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  collectionId        Int
  collection          Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  position            Int       @default(0)

  @@unique([productId, collectionId])
  @@map("product_collections")
}

// =============================================================================
// FACET / FACET VALUE
// =============================================================================
model Facet {
  id                  Int       @id @default(autoincrement())

  name                String
  code                String    @unique

  vendureFacetId      String?   @unique

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  values              FacetValue[]

  @@map("facets")
}

model FacetValue {
  id                  Int       @id @default(autoincrement())

  facetId             Int
  facet               Facet     @relation(fields: [facetId], references: [id], onDelete: Cascade)

  name                String
  code                String

  vendureFacetValueId String?   @unique

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  products            ProductFacetValue[]

  @@unique([facetId, code])
  @@map("facet_values")
}

model ProductFacetValue {
  id                  Int       @id @default(autoincrement())

  productId           Int
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  facetValueId        Int
  facetValue          FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)

  @@unique([productId, facetValueId])
  @@map("product_facet_values")
}

// =============================================================================
// ORDER
// =============================================================================
model Order {
  id                  Int       @id @default(autoincrement())

  orderNumber         String    @unique

  vendureOrderId      String?
  vendureParentOrderId String?

  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id])

  buyerId             String
  buyerEmail          String
  buyerName           String

  subtotal            Float
  shippingTotal       Float     @default(0)
  taxTotal            Float     @default(0)
  discountTotal       Float     @default(0)
  total               Float

  platformFee         Float     @default(0)
  vendorPayout        Float

  // Commission Tracking
  commissionRate      Float     @default(0)      // Rate applied (e.g., 0.10 for 10%)
  commissionAmount    Float     @default(0)      // Calculated commission in currency

  // Stripe Payment Tracking
  stripePaymentIntentId   String?
  stripeTransferId        String?
  stripePayoutId          String?

  // Payout Tracking
  payoutMode          String    @default("instant") // instant, manual
  payoutStatus        String    @default("pending") // pending, transferred, held, paid_out, failed
  payoutScheduledAt   DateTime?
  payoutCompletedAt   DateTime?

  status              String    @default("PENDING")
  paymentStatus       String    @default("PENDING")
  fulfillmentStatus   String    @default("UNFULFILLED")

  shippingAddress     String?   // JSON string
  shippingMethod      String?
  trackingNumber      String?
  trackingUrl         String?

  customerNotes       String?
  internalNotes       String?

  placedAt            DateTime  @default(now())
  paidAt              DateTime?
  fulfilledAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lines               OrderLine[]

  @@index([vendorId])
  @@index([buyerId])
  @@index([status])
  @@index([vendureOrderId])
  @@index([placedAt])
  @@index([stripePaymentIntentId])
  @@index([payoutStatus])
  @@map("orders")
}

model OrderLine {
  id                  Int       @id @default(autoincrement())

  orderId             Int
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId           Int?
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName         String
  productSku          String
  productType         String

  unitPrice           Float
  quantity            Int
  lineTotal           Float

  downloadUrl         String?
  downloadCount       Int       @default(0)
  downloadExpiresAt   DateTime?

  vendureOrderLineId  String?

  @@index([orderId])
  @@map("order_lines")
}

// =============================================================================
// REVIEW
// =============================================================================
model Review {
  id                  Int       @id @default(autoincrement())

  productId           Int?
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  authorId            String
  authorName          String
  authorEmail         String

  rating              Int
  title               String?
  body                String?

  status              String    @default("PENDING")
  verifiedPurchase    Boolean   @default(false)

  vendorResponse      String?
  respondedAt         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([productId])
  @@index([vendorId])
  @@index([authorId])
  @@index([status])
  @@map("reviews")
}

// =============================================================================
// MESSAGING
// =============================================================================
model Message {
  id                  Int       @id @default(autoincrement())

  senderId            String
  senderType          String    // VENDOR, BUYER, ADMIN

  receiverId          String
  receiverType        String

  vendorId            Int?
  vendor              Seller?   @relation("SellerMessages", fields: [vendorId], references: [id], onDelete: Cascade)

  subject             String?
  content             String

  attachments         String?   @default("[]") // JSON array

  orderId             Int?
  productId           Int?

  messageType         String    @default("GENERAL")

  read                Boolean   @default(false)
  readAt              DateTime?

  parentMessageId     Int?
  parentMessage       Message?  @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies             Message[] @relation("MessageThread")

  createdAt           DateTime  @default(now())

  @@index([vendorId])
  @@index([senderId])
  @@index([receiverId])
  @@index([read])
  @@map("messages")
}

// =============================================================================
// CALENDAR / APPOINTMENTS
// =============================================================================
model CalendarEvent {
  id                  Int       @id @default(autoincrement())

  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  customerId          String?
  customerName        String?
  customerEmail       String?
  customerPhone       String?

  title               String
  description         String?
  eventType           String    // SERVICE_APPOINTMENT, TUNE_SESSION, etc.

  startTime           DateTime
  endTime             DateTime
  allDay              Boolean   @default(false)
  timezone            String    @default("UTC")

  location            String?
  isVirtual           Boolean   @default(false)
  meetingUrl          String?

  status              String    @default("PENDING")

  orderId             Int?
  vehicleInfo         String?   // JSON string

  reminders           String?   @default("[]") // JSON array

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([vendorId])
  @@index([startTime])
  @@index([status])
  @@map("calendar_events")
}

// =============================================================================
// SYNC LOG
// =============================================================================
model SyncLog {
  id                  Int       @id @default(autoincrement())

  entity              String
  entityId            String

  vendorId            Int?
  vendor              Seller?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  action              String    // CREATE, UPDATE, DELETE
  direction           String    // VENDURE_TO_MARKETPLACE, MARKETPLACE_TO_VENDURE

  payload             String    // JSON string

  status              String    @default("PENDING")
  errorMessage        String?
  retryCount          Int       @default(0)

  attemptedAt         DateTime  @default(now())
  completedAt         DateTime?

  @@index([entity, entityId])
  @@index([status])
  @@index([attemptedAt])
  @@map("sync_logs")
}

// =============================================================================
// BUYER CONNECTION
// =============================================================================
model BuyerConnection {
  id                  Int       @id @default(autoincrement())

  buyerId             String
  sellerId            Int

  connectionType      String    @default("SAVED")

  notes               String?

  notifyOnNewProducts Boolean   @default(false)
  notifyOnSales       Boolean   @default(false)

  connectedAt         DateTime  @default(now())
  lastInteractionAt   DateTime  @default(now())

  @@unique([buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("buyer_connections")
}

// =============================================================================
// PAYOUT
// =============================================================================
model Payout {
  id                  Int       @id @default(autoincrement())

  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount              Float
  currency            String    @default("USD")

  paymentMethod       String    // STRIPE, PAYPAL, BANK_TRANSFER, MANUAL
  paymentReference    String?

  // Stripe-specific fields
  stripePayoutId      String?
  stripeTransferId    String?

  status              String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  periodStart         DateTime
  periodEnd           DateTime

  orderIds            String?   @default("[]") // JSON array
  orderCount          Int       @default(0)

  // Processing details
  processedBy         String?   // Admin user ID who triggered payout
  processedAt         DateTime?
  failedAt            DateTime?
  failureReason       String?

  createdAt           DateTime  @default(now())

  @@index([vendorId])
  @@index([status])
  @@index([stripePayoutId])
  @@map("payouts")
}

// =============================================================================
// COMMISSION CONFIGURATION
// =============================================================================
model CommissionConfig {
  id                  Int       @id @default(autoincrement())

  productType         String    @unique  // TUNE, PART, SERVICE, CUSTOM_INVOICE
  commissionRate      Float              // Percentage as decimal (e.g., 0.10 for 10%)
  fixedFee            Float     @default(0) // Optional fixed fee in cents

  isActive            Boolean   @default(true)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("commission_configs")
}

// =============================================================================
// INVOICE (Custom one-time payment links)
// =============================================================================
model Invoice {
  id                  Int       @id @default(autoincrement())

  // Invoice identifier
  invoiceNumber       String    @unique
  token               String    @unique  // Unique payment token for URL

  // Vendure integration
  vendureProductId    String?

  // Seller relationship
  vendorId            Int
  vendor              Seller    @relation(fields: [vendorId], references: [id])

  // Recipient info
  recipientEmail      String
  recipientName       String?
  recipientCustomerId String?   // Vendure customer ID if known

  // Invoice details
  name                String    // Invoice title
  description         String?
  notes               String?
  lineItems           String?   // JSON array of line items

  // Amounts (in dollars)
  subtotal            Float
  total               Float
  platformFee         Float     @default(0)
  vendorPayout        Float

  // Commission
  commissionRate      Float     @default(0)
  commissionAmount    Float     @default(0)

  // Payment info
  stripePaymentIntentId   String?
  stripeTransferId        String?

  // Status
  status              String    @default("draft")  // draft, sent, paid, expired, cancelled
  paymentStatus       String    @default("pending") // pending, paid, failed, refunded

  // Dates
  createdAt           DateTime  @default(now())
  sentAt              DateTime?
  expiresAt           DateTime?
  paidAt              DateTime?
  cancelledAt         DateTime?

  // Related order (created on payment)
  orderId             Int?

  @@index([vendorId])
  @@index([recipientEmail])
  @@index([token])
  @@index([status])
  @@map("invoices")
}

// =============================================================================
// PLATFORM SETTINGS
// =============================================================================
model PlatformSettings {
  id                  Int       @id @default(autoincrement())

  key                 String    @unique
  value               String
  description         String?

  updatedAt           DateTime  @updatedAt

  @@map("platform_settings")
}
