{{> header title="Reset Your Password" }}

<!-- Main content -->
<mj-section background-color="#27272a" padding="32px 24px" border-radius="12px">
    <mj-column>
        <!-- Icon -->
        <mj-text align="center" padding-bottom="16px">
            <span style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 50%; line-height: 64px; font-size: 28px;">&#128274;</span>
        </mj-text>

        <!-- Title -->
        <mj-text align="center" font-size="24px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            Password Reset Request
        </mj-text>

        <!-- Subtitle -->
        <mj-text align="center" font-size="14px" color="#a1a1aa" padding-bottom="24px">
            Someone requested a password reset for your TunerSwap account. If this was you, click the button below.
        </mj-text>

        <!-- Button -->
        <mj-button href="{{ passwordResetUrl }}?token={{ passwordResetToken }}"
                   background-color="#f59e0b"
                   color="white"
                   font-size="16px"
                   font-weight="bold"
                   border-radius="12px"
                   padding="16px 32px"
                   inner-padding="16px 32px">
            Reset Password
        </mj-button>

        <!-- Alternative link text -->
        <mj-text align="center" font-size="12px" color="#71717a" padding-top="24px">
            If the button doesn't work, copy and paste this link into your browser:
        </mj-text>
        <mj-text align="center" font-size="11px" color="#3b82f6" padding-top="8px" word-break="break-all">
            {{ passwordResetUrl }}?token={{ passwordResetToken }}
        </mj-text>
    </mj-column>
</mj-section>

<!-- Warning box -->
<mj-section background-color="#1f2937" padding="16px 24px">
    <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
            If you didn't request this password reset, you can safely ignore this email. Your password won't change until you click the link above.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
