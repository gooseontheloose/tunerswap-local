{{> header title="Verify Your Email Address" }}

<!-- Main content card -->
<mj-section background-color="#18181b" padding="32px 24px" border-radius="8px">
    <mj-column>
        <!-- Icon -->
        <mj-text align="center" padding-bottom="16px">
            <span style="display: inline-block; width: 56px; height: 56px; background-color: #22c55e; border-radius: 50%; line-height: 56px; font-size: 24px; color: white;">&#10003;</span>
        </mj-text>

        <!-- Title -->
        <mj-text align="center" font-size="22px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            Verify Your Email
        </mj-text>

        <!-- Message -->
        <mj-text align="center" font-size="14px" color="#a1a1aa" padding-bottom="24px">
            Thanks for signing up for TunerSwap! Click the button below to verify your email address and activate your account.
        </mj-text>

        <!-- Button -->
        <mj-button href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}"
                   background-color="#ef4444"
                   color="white"
                   font-size="16px"
                   font-weight="bold"
                   border-radius="8px"
                   padding="14px 32px"
                   inner-padding="14px 32px">
            Verify Email Address
        </mj-button>

        <!-- Alternative link -->
        <mj-text align="center" font-size="12px" color="#52525b" padding-top="24px">
            Or copy and paste this link into your browser:
        </mj-text>
        <mj-text align="center" font-size="11px" color="#3b82f6" padding-top="8px" css-class="link-text">
            {{ verifyEmailAddressUrl }}?token={{ verificationToken }}
        </mj-text>
    </mj-column>
</mj-section>

<!-- Expiration notice -->
<mj-section padding="16px 24px">
    <mj-column>
        <mj-text align="center" font-size="12px" color="#52525b">
            This verification link will expire in 24 hours.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
