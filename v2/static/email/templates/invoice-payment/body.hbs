{{> header title="Invoice Payment Request" }}

<mj-raw>
    <style type="text/css">
    .line-items-table { width: 100%; }
    .line-items-table td { padding: 12px 8px; border-bottom: 1px solid #3f3f46; }
    .line-items-table .total-row td { border-bottom: none; font-weight: bold; font-size: 16px; }
    </style>
</mj-raw>

<!-- Greeting -->
<mj-section background-color="#27272a" padding="32px 24px 16px 24px">
    <mj-column>
        <!-- Icon -->
        <mj-text align="center" padding-bottom="16px">
            <span style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 50%; line-height: 64px; font-size: 28px;">&#128206;</span>
        </mj-text>

        <mj-text align="center" font-size="24px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            You've Received an Invoice
        </mj-text>

        <mj-text align="center" font-size="14px" color="#a1a1aa">
            {{ sellerName }} has sent you an invoice for payment.
        </mj-text>
    </mj-column>
</mj-section>

<!-- Invoice Info Cards -->
<mj-section background-color="#27272a" padding="16px 24px">
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">FROM</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#a855f7">{{ sellerName }}</mj-text>
    </mj-column>
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">INVOICE DATE</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#ffffff">{{ invoiceDate }}</mj-text>
    </mj-column>
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">AMOUNT DUE</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#ef4444">{{ totalAmount }}</mj-text>
    </mj-column>
</mj-section>

<!-- Divider -->
<mj-section background-color="#27272a" padding="16px 24px">
    <mj-column>
        <mj-divider border-width="1px" border-color="#3f3f46" />
    </mj-column>
</mj-section>

<!-- Invoice Details -->
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            {{ invoiceName }}
        </mj-text>
        {{#if description}}
        <mj-text font-size="14px" color="#a1a1aa" padding-bottom="16px">
            {{ description }}
        </mj-text>
        {{/if}}
    </mj-column>
</mj-section>

<!-- Line Items (if any) -->
{{#if lineItems}}
<mj-section background-color="#27272a" padding="0 24px">
    <mj-column>
        <mj-text font-size="12px" font-weight="bold" color="#a1a1aa" padding-bottom="16px">ITEMS</mj-text>
        <mj-table cellpadding="8px" css-class="line-items-table">
            {{#each lineItems }}
            <tr>
                <td style="color: #e5e5e5;">
                    <strong>{{ description }}</strong>
                    {{#if (gt quantity 1)}}<br/><span style="color: #a1a1aa; font-size: 12px;">Qty: {{ quantity }}</span>{{/if}}
                </td>
                <td style="text-align: right; color: #e5e5e5; white-space: nowrap;">
                    ${{ formattedPrice }}
                </td>
            </tr>
            {{/each}}
        </mj-table>
    </mj-column>
</mj-section>
{{/if}}

<!-- Divider -->
<mj-section background-color="#27272a" padding="16px 24px">
    <mj-column>
        <mj-divider border-width="1px" border-color="#3f3f46" />
    </mj-column>
</mj-section>

<!-- Total -->
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text align="right" font-size="12px" color="#a1a1aa" padding-bottom="4px">TOTAL DUE</mj-text>
        <mj-text align="right" font-size="28px" font-weight="bold" color="#ef4444">
            {{ totalAmount }}
        </mj-text>
    </mj-column>
</mj-section>

<!-- Notes -->
{{#if notes}}
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text font-size="12px" font-weight="bold" color="#a1a1aa" padding-bottom="8px">NOTE FROM SELLER</mj-text>
        <mj-text font-size="14px" color="#e5e5e5" padding="16px" background-color="#18181b" border-radius="8px">
            {{ notes }}
        </mj-text>
    </mj-column>
</mj-section>
{{/if}}

<!-- Due Date Warning -->
{{#if expiresAt}}
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text align="center" font-size="12px" color="#f59e0b" padding="12px" background-color="#78350f33" border-radius="8px">
            &#9888; Payment due by: {{ expiresAt }}
        </mj-text>
    </mj-column>
</mj-section>
{{/if}}

<!-- Pay Now CTA -->
<mj-section background-color="#27272a" padding="24px">
    <mj-column>
        <mj-button href="{{ paymentUrl }}"
                   background-color="#a855f7"
                   color="white"
                   font-size="16px"
                   font-weight="bold"
                   border-radius="12px"
                   padding="16px 48px"
                   inner-padding="16px 48px">
            Pay {{ totalAmount }} Now
        </mj-button>
        <mj-text align="center" font-size="12px" color="#71717a" padding-top="16px">
            Secure payment powered by Stripe
        </mj-text>
    </mj-column>
</mj-section>

<!-- Payment Link Backup -->
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text font-size="12px" color="#71717a" padding-bottom="8px">
            If the button doesn't work, copy and paste this link:
        </mj-text>
        <mj-text font-size="12px" color="#a855f7" padding="12px" background-color="#18181b" border-radius="8px" word-break="break-all">
            {{ paymentUrl }}
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
