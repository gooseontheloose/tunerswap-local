<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-preview>{{ title }}</mj-preview>
        <mj-attributes>
            <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
            <mj-text font-size="14px" color="#e5e5e5" line-height="1.6" />
            <mj-button background-color="#ef4444" color="white" border-radius="8px" font-weight="bold" font-size="16px" />
            <mj-section padding="0" />
        </mj-attributes>
        <mj-style>
            .logo-text { font-size: 28px; font-weight: bold; }
            a { color: #3b82f6; }
        </mj-style>
    </mj-head>

    <mj-body background-color="#09090b">
        <!-- Logo Header -->
        <mj-section background-color="#18181b" padding="24px">
            <mj-column>
                <mj-text align="center" font-size="28px" font-weight="bold" color="#ef4444">
                    TunerSwap
                </mj-text>
                <mj-text align="center" font-size="12px" color="#71717a" padding-top="4px">
                    The Automotive Tuning Marketplace
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Red accent line -->
        <mj-section padding="0">
            <mj-column>
                <mj-divider border-width="2px" border-color="#ef4444" padding="0" />
            </mj-column>
        </mj-section>
