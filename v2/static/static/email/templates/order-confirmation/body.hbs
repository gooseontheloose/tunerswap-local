{{> header title="Order Confirmation" }}

<mj-raw>
    <style type="text/css">
    .order-table { width: 100%; }
    .order-table td { padding: 12px 8px; border-bottom: 1px solid #3f3f46; }
    .order-table .product-img { width: 60px; border-radius: 8px; }
    .order-total td { border-bottom: none; font-weight: bold; font-size: 16px; }
    </style>
</mj-raw>

<!-- Greeting -->
<mj-section background-color="#27272a" padding="32px 24px 16px 24px">
    <mj-column>
        <!-- Icon -->
        <mj-text align="center" padding-bottom="16px">
            <span style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #22c55e, #16a34a); border-radius: 50%; line-height: 64px; font-size: 28px;">&#10003;</span>
        </mj-text>

        <mj-text align="center" font-size="24px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            Order Confirmed!
        </mj-text>

        <mj-text align="center" font-size="14px" color="#a1a1aa">
            Thanks for your order, {{ order.customer.firstName }}! We're getting it ready.
        </mj-text>
    </mj-column>
</mj-section>

<!-- Order Info Cards -->
<mj-section background-color="#27272a" padding="0 24px">
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">ORDER NUMBER</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#22c55e">{{ order.code }}</mj-text>
    </mj-column>
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">ORDER DATE</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#ffffff">{{ formatDate order.orderPlacedAt }}</mj-text>
    </mj-column>
    <mj-column width="33%">
        <mj-text align="center" font-size="11px" color="#71717a" padding-bottom="4px">TOTAL</mj-text>
        <mj-text align="center" font-size="14px" font-weight="bold" color="#ef4444">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</mj-text>
    </mj-column>
</mj-section>

<!-- Divider -->
<mj-section background-color="#27272a" padding="16px 24px">
    <mj-column>
        <mj-divider border-width="1px" border-color="#3f3f46" />
    </mj-column>
</mj-section>

<!-- Shipping Address -->
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-text font-size="12px" font-weight="bold" color="#a1a1aa" padding-bottom="8px">SHIPPING TO</mj-text>
        {{#with order.shippingAddress }}
        <mj-text font-size="14px" color="#e5e5e5" line-height="1.6">
            <strong>{{ fullName }}</strong><br/>
            {{#if company}}{{ company }}<br/>{{/if}}
            {{#if streetLine1}}{{ streetLine1 }}<br/>{{/if}}
            {{#if streetLine2}}{{ streetLine2 }}<br/>{{/if}}
            {{#if city}}{{ city }}, {{/if}}{{#if province}}{{ province }} {{/if}}{{#if postalCode}}{{ postalCode }}{{/if}}<br/>
            {{#if country}}{{ country }}{{/if}}
        </mj-text>
        {{/with}}
    </mj-column>
</mj-section>

<!-- Divider -->
<mj-section background-color="#27272a" padding="0 24px 16px 24px">
    <mj-column>
        <mj-divider border-width="1px" border-color="#3f3f46" />
    </mj-column>
</mj-section>

<!-- Order Items -->
<mj-section background-color="#27272a" padding="0 24px">
    <mj-column>
        <mj-text font-size="12px" font-weight="bold" color="#a1a1aa" padding-bottom="16px">ORDER ITEMS</mj-text>
        <mj-table cellpadding="8px" css-class="order-table">
            {{#each order.lines }}
            <tr>
                <td style="width: 70px;">
                    <img alt="{{ productVariant.name }}"
                         class="product-img"
                         style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover;"
                         src="{{ featuredAsset.preview }}?w=120&h=120" />
                </td>
                <td style="color: #e5e5e5;">
                    <strong>{{ productVariant.name }}</strong><br/>
                    <span style="color: #a1a1aa; font-size: 12px;">Qty: {{ quantity }}</span>
                </td>
                <td style="text-align: right; color: #e5e5e5; white-space: nowrap;">
                    {{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}
                </td>
            </tr>
            {{/each}}
            {{#each order.discounts }}
            <tr>
                <td colspan="2" style="color: #22c55e;">{{ description }}</td>
                <td style="text-align: right; color: #22c55e;">{{ formatMoney amount ../order.currencyCode 'en' }}</td>
            </tr>
            {{/each}}
            <tr>
                <td colspan="2" style="color: #a1a1aa;">Subtotal</td>
                <td style="text-align: right; color: #e5e5e5;">{{ formatMoney order.subTotalWithTax order.currencyCode 'en' }}</td>
            </tr>
            {{#each shippingLines }}
            <tr>
                <td colspan="2" style="color: #a1a1aa;">Shipping ({{ shippingMethod.name }})</td>
                <td style="text-align: right; color: #e5e5e5;">{{ formatMoney priceWithTax ../order.currencyCode 'en' }}</td>
            </tr>
            {{/each}}
            <tr class="order-total">
                <td colspan="2" style="color: #ffffff; padding-top: 16px;">Total</td>
                <td style="text-align: right; color: #ef4444; padding-top: 16px;">{{ formatMoney order.totalWithTax order.currencyCode 'en' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<!-- CTA -->
<mj-section background-color="#27272a" padding="24px">
    <mj-column>
        <mj-button href="https://tuner-swap.com/account/orders"
                   background-color="#ef4444"
                   color="white"
                   font-size="14px"
                   font-weight="bold"
                   border-radius="12px"
                   padding="14px 28px"
                   inner-padding="14px 28px">
            View Order Status
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
