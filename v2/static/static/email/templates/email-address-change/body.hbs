{{> header title="Verify Your New Email Address" }}

<!-- Main content -->
<mj-section background-color="#27272a" padding="32px 24px" border-radius="12px">
    <mj-column>
        <!-- Icon -->
        <mj-text align="center" padding-bottom="16px">
            <span style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 50%; line-height: 64px; font-size: 28px;">&#9993;</span>
        </mj-text>

        <!-- Title -->
        <mj-text align="center" font-size="24px" font-weight="bold" color="#ffffff" padding-bottom="8px">
            Confirm Email Change
        </mj-text>

        <!-- Subtitle -->
        <mj-text align="center" font-size="14px" color="#a1a1aa" padding-bottom="24px">
            We received a request to change your TunerSwap account email to this address. Click below to confirm.
        </mj-text>

        <!-- Button -->
        <mj-button href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}"
                   background-color="#3b82f6"
                   color="white"
                   font-size="16px"
                   font-weight="bold"
                   border-radius="12px"
                   padding="16px 32px"
                   inner-padding="16px 32px">
            Confirm New Email
        </mj-button>

        <!-- Alternative link text -->
        <mj-text align="center" font-size="12px" color="#71717a" padding-top="24px">
            If the button doesn't work, copy and paste this link into your browser:
        </mj-text>
        <mj-text align="center" font-size="11px" color="#3b82f6" padding-top="8px" word-break="break-all">
            {{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}
        </mj-text>
    </mj-column>
</mj-section>

<!-- Warning box -->
<mj-section background-color="#1f2937" padding="16px 24px">
    <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
            If you didn't request this change, please secure your account immediately by changing your password.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
