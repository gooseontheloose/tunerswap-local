    "seed:vehicles:fetch": "ts-node ./src/plugins/my-garage/seed-data/nhtsa-fetcher.ts",
    "populate": "ts-node ./src/populate-initial-data.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@graphql-tools/schema": "^10.0.30",
    "@prisma/client": "^5.22.0",
    "@vendure/asset-server-plugin": "3.5.1",
    "@vendure/core": "3.5.1",
    "@vendure/dashboard": "3.5.1",
    "@vendure/email-plugin": "3.5.1",
    "@vendure/graphiql-plugin": "3.5.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.5.0",
    "cors": "^2.8.5",
    "dotenv": "17.2.3",
    "express": "^5.2.1",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "prisma": "^5.22.0",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@vendure/cli": "3.5.1",
    "concurrently": "9.2.1",
    "typescript": "5.8.2"
